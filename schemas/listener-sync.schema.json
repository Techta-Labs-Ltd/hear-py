{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hear-py/listener-sync.schema.json",
  "title": "Listener sync payload",
  "description": "Profile payload sent to POST /alexa/listeners/sync by src/services/listener_sync.py.",
  "type": "object",
  "required": [
    "alexaUserId",
    "listenerId",
    "skillId",
    "environment",
    "principalType",
    "deviceId",
    "apiEndpoint",
    "locale",
    "clientVersion",
    "listenerType",
    "playbackSpeed"
  ],
  "properties": {
    "alexaUserId": { "type": "string" },
    "listenerId": { "type": ["string", "null"] },
    "skillId": { "type": ["string", "null"] },
    "environment": { "type": "string" },
    "principalType": {
      "enum": [
        "recognized_person",
        "skill_user",
        null
      ]
    },
    "listenerType": { "enum": ["guest", "registered"] },
    "deviceId": { "type": ["string", "null"] },
    "apiEndpoint": { "type": ["string", "null"] },
    "locale": { "type": ["string", "null"] },
    "userName": { "type": ["string", "null"] },
    "userEmail": { "type": ["string", "null"] },
    "address": { "type": ["string", "null"] },
    "city": { "type": ["string", "null"] },
    "state": { "type": ["string", "null"] },
    "country": { "type": ["string", "null"] },
    "countryCode": { "type": ["string", "null"] },
    "postalCode": { "type": ["string", "null"] },
    "latitude": { "type": ["number", "null"] },
    "longitude": { "type": ["number", "null"] },
    "clientVersion": { "type": "string" },
    "locality": { "type": ["string", "null"] },
    "playbackSpeed": { "type": ["number", "null"] }
  },
  "additionalProperties": false
}
