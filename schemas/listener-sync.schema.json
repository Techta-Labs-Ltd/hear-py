{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hear-py/listener-sync.schema.json",
  "title": "Alexa listener registration and sync payload",
  "description": "Payload sent to POST /alexa/listeners/sync by src/services/listener_sync.py.",
  "type": "object",
  "required": ["action", "alexaUserId", "listenerId"],
  "properties": {
    "action": { "const": "alexa" },
    "alexaUserId": { "type": "string", "minLength": 1 },
    "listenerId": { "type": ["string", "null"] },
    "listenerName": { "type": "string", "minLength": 1 },
    "email": { "type": "string", "format": "email", "minLength": 3 },
    "city": { "type": "string", "minLength": 1 },
    "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
    "latitude": { "type": "number", "minimum": -90, "maximum": 90 }
  },
  "additionalProperties": false
}
