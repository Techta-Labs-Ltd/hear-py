{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hear-py/listener-identity-resolve.schema.json",
  "title": "Canonical listener identity resolution",
  "description": "Request body sent to POST /alexa/listeners/resolve before Alexa state is loaded.",
  "type": "object",
  "properties": {
    "listenerId": { "type": "string", "format": "uuid" },
    "alexaUserId": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "userEmail": { "type": "string", "format": "email" }
  },
  "additionalProperties": false,
  "$defs": {
    "response": {
      "type": "object",
      "required": ["listenerId"],
      "properties": {
        "listenerId": { "type": "string", "minLength": 1 },
        "listenerType": { "enum": ["guest", "registered"] },
        "created": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  }
}
