{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hear-py/listener-identity-resolve.schema.json",
  "title": "Canonical listener identity resolution",
  "description": "Request body sent to POST /alexa/listeners/resolve before Alexa state is loaded.",
  "type": "object",
  "required": [
    "alexaUserId",
    "environment",
    "principalType",
    "clientVersion"
  ],
  "properties": {
    "alexaUserId": { "type": "string", "minLength": 1 },
    "personId": { "type": "string", "minLength": 1 },
    "deviceId": { "type": "string", "minLength": 1 },
    "skillId": { "type": "string", "minLength": 1 },
    "locale": { "type": "string" },
    "userEmail": { "type": "string", "format": "email", "minLength": 3 },
    "environment": { "type": "string", "minLength": 1 },
    "principalType": {
      "enum": [
        "recognized_person",
        "skill_user"
      ]
    },
    "clientVersion": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false,
  "$defs": {
    "response": {
      "type": "object",
      "required": ["listenerId"],
      "properties": {
        "listenerId": { "type": "string", "minLength": 1 },
        "listenerType": { "enum": ["guest", "registered"] },
        "created": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  }
}
