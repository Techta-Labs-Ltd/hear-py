{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hear-py/store.schema.json",
  "title": "Hear persisted user state",
  "description": "The only fields persisted into the single DynamoDB item per user (PERSISTED_FIELDS in src/models/persistence.py).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "activeDialog": { "type": ["object", "null"] },
    "activePlayback": { "type": ["object", "null"] },
    "answeredFeedbackKeys": { "type": "array", "items": { "type": "string" } },
    "awaitingCommunityPlayback": { "type": "boolean" },
    "awaitingContinueAfterFlag": { "type": "boolean" },
    "awaitingFeedback": { "type": "boolean" },
    "awaitingFollow": { "type": "boolean" },
    "awaitingLocationConfirm": { "type": "boolean" },
    "awaitingReportDecision": { "type": "boolean" },
    "awaitingResume": { "type": "boolean" },
    "awaitingSearchConfirmation": { "type": "boolean" },
    "currentPlaybackSpeeds": { "type": ["array", "null"], "items": { "type": "number" } },
    "deviceCountryCode": { "type": ["string", "null"] },
    "devicePostalCode": { "type": ["string", "null"] },
    "excludedSuggestions": { "type": "array", "items": { "type": "string" } },
    "feedbackAskedForToken": { "type": ["string", "null"] },
    "feedbackAskedTokens": { "type": "array", "items": { "type": "string" } },
    "feedbackCandidates": { "type": "array", "items": { "type": "object" } },
    "feedbackCategory": { "type": ["string", "null"] },
    "feedbackContentId": { "type": ["string", "null"] },
    "feedbackContentTitle": { "type": ["string", "null"] },
    "feedbackCreator": { "type": ["string", "null"] },
    "feedbackCreatorId": { "type": ["string", "null"] },
    "feedbackGivenTokens": { "type": "array", "items": { "type": "string" } },
    "feedbackPromptText": { "type": ["string", "null"] },
    "feedbackReminderAlertToken": { "type": ["string", "null"] },
    "firstLaunchedAt": { "type": ["number", "null"] },
    "followedCreators": { "type": "array", "items": { "type": "object" } },
    "fullName": { "type": ["string", "null"] },
    "lastCompletedSource": { "type": ["string", "null"] },
    "lastLaunchedAt": { "type": ["number", "null"] },
    "lastLatestSourceOfferContentId": { "type": ["string", "null"] },
    "lastOffsetMs": { "type": "number" },
    "lastToken": { "type": ["string", "null"] },
    "latitude": { "type": ["number", "null"] },
    "launchCount": { "type": "number" },
    "listModeActive": { "type": "boolean" },
    "listenerId": { "type": ["string", "null"] },
    "listenerProfileResolvedAt": { "type": ["number", "null"] },
    "listenerProfileSkipUntil": { "type": ["number", "null"] },
    "listenerSyncedAt": { "type": ["number", "null"] },
    "listeningPattern": { "type": "object" },
    "locality": { "type": ["string", "null"] },
    "localityResolvedAt": { "type": ["number", "null"] },
    "locationSource": { "type": ["string", "null"] },
    "longitude": { "type": ["number", "null"] },
    "onboardingComplete": { "type": "boolean" },
    "onboardingRetries": { "type": "number" },
    "onboardingStage": { "type": ["string", "null"] },
    "onboardingTownAttempts": { "type": "number" },
    "onboardingTownResolverFailures": { "type": "number" },
    "pendingAmbiguity": { "type": ["object", "null"] },
    "pendingFeedback": { "type": ["object", "null"] },
    "pendingLatestSource": { "type": ["object", "null"] },
    "pendingLocationConfirm": { "type": ["object", "null"] },
    "pendingResolution": { "type": ["object", "null"] },
    "pendingSuggestions": { "type": "array", "items": { "type": "object" } },
    "playCount": { "type": "number" },
    "playHistory": { "type": "array", "items": { "type": "object" } },
    "playbackQueue": { "type": ["object", "null"] },
    "playbackSpeed": { "type": "number" },
    "preparedNextContent": { "type": ["object", "null"] },
    "reportContext": { "type": ["object", "null"] },
    "suggestionIndex": { "type": "number" },
    "userAddress": { "type": ["string", "null"] },
    "userCity": { "type": ["string", "null"] },
    "userCountry": { "type": ["string", "null"] },
    "userEmail": { "type": ["string", "null"] },
    "userName": { "type": ["string", "null"] },
    "userState": { "type": ["string", "null"] }
  }
}
