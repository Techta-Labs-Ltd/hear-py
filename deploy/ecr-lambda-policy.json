{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LambdaECRImageRetrievalPolicy",
      "Effect": "Allow",
      "Principal": { "Service": "lambda.amazonaws.com" },
      "Action": [ "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer" ],
      "Condition": {
        "StringLike": { "aws:sourceArn": "arn:aws:lambda:eu-west-1:650790810013:function:*" }
      }
    }
  ]
}
