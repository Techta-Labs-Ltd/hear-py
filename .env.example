SENTRY_TRACES_SAMPLE_RATE=0

STAGE=development
NODE_ENV=development
DEBUG_HEAR=0

HEAR_TAXONOMY_MANIFEST_URL=https://cdn.hear.media/runtime/taxonomy/v3/manifest.json
HEAR_TAXONOMY_REVISION_TABLE=
HEAR_TAXONOMY_AUTO_REFRESH=0
HEAR_TAXONOMY_REFRESH_SECONDS=300
# Local runs use the checked-in downloaded production snapshot. The Docker
# image overrides this with /opt/hear-taxonomy during its build.
HEAR_TAXONOMY_BUNDLE_DIR=tests/fixtures/taxonomy
HEAR_SEMANTIC_ROUTER_ENABLED=0
HEAR_SEMANTIC_ROUTER_MODEL=BAAI/bge-small-en-v1.5
