HEAR_API_URL=https://alexa.hear.surf/api/v1
HEAR_API_PATH_PREFIX=alexa
HEAR_API_KEY=
S3_PERSISTENCE_BUCKET=hear-skill-persistence-storage
ALEXA_SKILL_ID=

HEAR_PERSISTENCE_DRIVER=dynamodb
HEAR_PERSISTENCE_TTL_DAYS=180
HEAR_DDB_TABLE=
HEAR_DDB_REGION=eu-west-1
