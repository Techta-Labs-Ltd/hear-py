RESOLVER_TLS=0
RESOLVER_API_KEY=
RESOLVER_DEFAULT_COUNTRY=gb
RESOLVER_RESOLVE_TIMEOUT_MS=2000
RESOLVER_HEALTH_TIMEOUT_MS=1000

HEAR_API_TIMEOUT_MS=8000
