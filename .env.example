HEAR_API_URL=https://alexa.hear.media/api/v1
HEAR_API_PATH_PREFIX=alexa
HEAR_API_KEY=

HEAR_PERSISTENCE_DRIVER=dynamodb
HEAR_PERSISTENCE_TTL_DAYS=180
HEAR_DDB_TABLE=
HEAR_DDB_PARTITION_KEY=alexaUserId
HEAR_DDB_REGION=eu-west-1

HEAR_CLIENT_VERSION=alexa-skill
HEAR_AUDIO_SPEED_PARAM=speed

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

STAGE=development
NODE_ENV=development
DEBUG_HEAR=0

POWERTOOLS_SERVICE_NAME=hear-alexa-skill
POWERTOOLS_LOG_LEVEL=INFO

HEAR_API_TIMEOUT_MS=8000
HEAR_API_RETRY=0

HEAR_FEEDBACK_RATIO=0.7
HEAR_SEARCH_PAGE_LIMIT=3
HEAR_QUEUE_PREFETCH_LIMIT=10
HEAR_BROWSE_MAX_CATALOG=50
HEAR_MAX_TRACK_LISTEN_LOG=20
HEAR_RECENT_EXCLUDE_LIMIT=20
