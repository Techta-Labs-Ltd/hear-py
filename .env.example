HEAR_SEMANTIC_ROUTER_THRESHOLD=0.72
HEAR_SEMANTIC_ROUTER_THREADS=2

WEBHOOK_SECRET=
WEBHOOK_OUTBOUND_SECRET=
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
WEBHOOK_API_GATEWAY_URL=
SETTINGS_TABLE=hear_settings
NOTIFICATIONS_TABLE=hear_notifications
WEBHOOK_OUTBOUND_URL=
SQS_OUT_QUEUE_URL=
POWERTOOLS_SERVICE_NAME=hear-alexa-skill
POWERTOOLS_LOG_LEVEL=INFO

RESOLVER_HOST=
